# ==============================================================================
# StackSense Environment Configuration
# ==============================================================================
# Note: StackSense runs 100% locally and deterministically without ANY API keys.
# All recommendation logic, hard constraint filtering, and multi-objective
# scoring are implemented in pure Python.
# ==============================================================================

# LLM-off switch (Mandatory per Section 5.1 of official problem statement)
# Default is false. Set to true only if optional natural language explanation
# polish is enabled.
ENABLE_LLM=false

# Optional API Keys (Only used if ENABLE_LLM=true for free-text description parsing)
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Engine Configuration
STACKSENSE_CATALOG_PATH=data/technology-catalog/catalogue.json
STACKSENSE_OUTPUT_DIR=outputs
